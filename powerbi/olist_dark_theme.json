{
  "name": "Olist Dark v3",
  "dataColors": ["#2EC4B6", "#FFB703", "#9B8CFF", "#FF6B6B", "#F4A261", "#8ECAE6", "#E9C46A", "#B5E48C"],
  "background": "#1F1F1F",
  "foreground": "#EBEBEB",
  "tableAccent": "#2EC4B6",
  "good": "#2EC4B6",
  "neutral": "#FFB703",
  "bad": "#FF6B6B",
  "maximum": "#FF6B6B",
  "center": "#FFB703",
  "minimum": "#2EC4B6",
  "textClasses": {
    "callout": { "fontSize": 24, "fontFace": "Segoe UI Semibold", "color": "#FFFFFF" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#EBEBEB" },
    "header": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#EBEBEB" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#BDBDBD" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#313131" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#111111" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#1F1F1F" } }, "transparency": 0 }],
        "border": [{ "show": false }],
        "visualHeader": [{ "background": { "solid": { "color": "#1F1F1F" } }, "foreground": { "solid": { "color": "#EBEBEB" } } }],
        "title": [{ "fontColor": { "solid": { "color": "#EBEBEB" } } }],
        "subTitle": [{ "fontColor": { "solid": { "color": "#BDBDBD" } } }],
        "categoryAxis": [{ "labelColor": { "solid": { "color": "#BDBDBD" } }, "gridlineColor": { "solid": { "color": "#333333" } } }],
        "valueAxis": [{ "labelColor": { "solid": { "color": "#BDBDBD" } }, "gridlineColor": { "solid": { "color": "#333333" } } }],
        "legend": [{ "labelColor": { "solid": { "color": "#BDBDBD" } } }],
        "labels": [{ "color": { "solid": { "color": "#EBEBEB" } } }]
      }
    },
    "lineChart": {
      "*": {
        "dataPoint": [{ "defaultColor": { "solid": { "color": "#FF6B6B" } } }]
      }
    },
    "clusteredBarChart": {
      "*": {
        "dataPoint": [{ "defaultColor": { "solid": { "color": "#9B8CFF" } } }]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "dataPoint": [{ "defaultColor": { "solid": { "color": "#2EC4B6" } } }]
      }
    }
  }
}
